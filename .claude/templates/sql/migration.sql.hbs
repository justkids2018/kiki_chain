-- 创建 {{table_name}} 表
-- 生成时间: {{timestamp}}
-- 契约版本: {{version}}

CREATE TABLE IF NOT EXISTS {{table_name}} (
{{#each fields}}
    {{name}} {{db_type}}{{#if required}} NOT NULL{{/if}}{{#if default_value}} DEFAULT {{default_value}}{{/if}},
{{/each}}
    PRIMARY KEY (id)
);

-- 创建索引
{{#each indexes}}
CREATE INDEX idx_{{../table_name}}_{{join columns "_"}} ON {{../table_name}}({{join columns ", "}});
{{/each}}

-- 添加外键约束
{{#each relations}}
{{#if foreign_key}}
ALTER TABLE {{../table_name}}
    ADD CONSTRAINT fk_{{../table_name}}_{{table}}
    FOREIGN KEY ({{foreign_key}}) REFERENCES {{table}}(id)
    ON DELETE {{on_delete}};
{{/if}}
{{/each}}

-- 添加表注释
COMMENT ON TABLE {{table_name}} IS '{{description}}';

-- 添加字段注释
{{#each fields}}
COMMENT ON COLUMN {{../table_name}}.{{name}} IS '{{description}}';
{{/each}}
