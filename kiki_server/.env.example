# Core runtime
ENVIRONMENT=development
DATABASE_URL=postgresql://app_user:password@localhost:5432/app_db
JWT_SECRET=replace-with-a-strong-random-secret

# Qiniu storage
QINIU_ACCESS_KEY=your-qiniu-access-key
QINIU_SECRET_KEY=your-qiniu-secret-key
QINIU_BUCKET=your-bucket
QINIU_DOMAIN=your-domain
QINIU_UPLOAD_REGION=z2

# Optional: explicit upload endpoint (recommended in CI/server)
# Example: https://up-z2.qiniup.com
KIKI_KEEP_QINIU_UPLOAD_URL=
# Optional: region auto mapping if QINIU_UPLOAD_URL is empty
# Allowed: z0, z1, z2, na0, as0
# Optional: object key prefix for backend uploads
KIKI_KEEP_QINIU_KEY_PREFIX=kiki

# Backward compatibility:
# QINIU_DOMAIN / QINIU_UPLOAD_URL / QINIU_KEY_PREFIX are still supported.
