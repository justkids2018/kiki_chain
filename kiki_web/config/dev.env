# 开发环境配置

# API基础URL
# 本地局域网调试 (用于移动端真机 / 模拟器测试，已自动获取您的本地IP 192.168.3.101)
API_BASE_URL=http://192.168.3.101:8081
# 本地回环调试 (仅用于电脑端 Chrome / macOS 客户端)
# API_BASE_URL=http://127.0.0.1:8081
# 安卓模拟器专用 (若局域网IP连不上，可尝试 10.0.2.2)
# API_BASE_URL=http://10.0.2.2:8081
# 远程线上开发环境 (原域名)
#API_BASE_URL=https://kiki.keepthinking.me
qi
# 环境类型
ENV_TYPE=dev

# 是否开启调试模式
DEBUG=true

# 是否开启日志
ENABLE_LOGGING=true

# 网络超时时间(毫秒)
CONNECT_TIMEOUT=30000
RECEIVE_TIMEOUT=30000
SEND_TIMEOUT=30000

# 是否开启网络缓存
ENABLE_CACHE=true

# 缓存过期时间(分钟)
CACHE_EXPIRE_MINUTES=5

# 最大重试次数
MAX_RETRY_COUNT=3

# 应用名称
APP_NAME=Hi Kiki

# 默认分页大小
DEFAULT_PAGE_SIZE=20
