      AppLogger.info('📤 Updating {{entity_name}}: $id');

      final result = await _repository.update{{entity_name}}(
        id: id,
{{#each update_fields}}
        {{camelCase name}}: {{camelCase name}},
{{/each}}
      );

{{#if has_list_api}}
      // 更新列表中的项
      final index = items.indexWhere((item) => item.id == id);
      if (index != -1) {
        items[index] = result;
      }
{{/if}}

{{#if has_get_api}}
      // 更新当前详情
      if (current{{entity_name}}.value?.id == id) {
        current{{entity_name}}.value = result;
      }
{{/if}}

      AppLogger.info('✅ {{entity_name}} updated successfully');

      Get.snackbar(
        '更新成功',
        '{{entity_name}} 已更新',
        snackPosition: SnackPosition.BOTTOM,
