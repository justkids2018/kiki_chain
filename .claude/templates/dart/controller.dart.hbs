class {{entity_name}}Controller extends GetxController {
  {{entity_name}}Controller({
    I{{entity_name}}Repository? repository,
  }) : _repository = repository ?? ServiceLocator.instance.{{camelCase snake_case_name}}Repository;

  final I{{entity_name}}Repository _repository;

{{#if has_list_api}}
  // 列表数据
  final RxList<{{entity_name}}> items = <{{entity_name}}>[].obs;
  final RxBool isLoading = false.obs;
  final RxString errorMessage = ''.obs;

  // 分页参数
  final RxInt currentPage = 1.obs;
  final RxInt pageSize = 20.obs;
  final RxBool hasMore = true.obs;

{{/if}}
{{#if has_get_api}}
  // 当前详情
  final Rx<{{entity_name}}?> current{{entity_name}} = Rx<{{entity_name}}?>(null);
  final RxBool isLoadingDetail = false.obs;

{{/if}}
  @override
  void onInit() {
    super.onInit();
{{#if has_list_api}}
    loadItems();
{{/if}}
  }

{{#if has_list_api}}
  /// 加载列表
  Future<void> loadItems({bool refresh = false}) async {
    try {
      if (refresh) {
        currentPage.value = 1;
        hasMore.value = true;
      }

      isLoading.value = true;
      errorMessage.value = '';

      AppLogger.info('📦 Loading {{entity_name}} list (page: ${currentPage.value})');

      final result = await _repository.get{{entity_name}}List(
        page: currentPage.value,
        pageSize: pageSize.value,
      );

      if (refresh) {
        items.value = result;
      } else {
        items.addAll(result);
      }

      hasMore.value = result.length >= pageSize.value;

      if (result.isNotEmpty) {
        currentPage.value++;
      }

      AppLogger.info('✅ Loaded ${result.length} {{entity_name}}(s)');
    } catch (e, stackTrace) {
      AppLogger.error('❌ Failed to load {{entity_name}} list', e, stackTrace);
      errorMessage.value = e.toString();

      Get.snackbar(
        '加载失败',
        e.toString(),
        snackPosition: SnackPosition.BOTTOM,
      );
    } finally {
      isLoading.value = false;
    }
  }

  /// 刷新列表
  Future<void> refreshItems() async {
    await loadItems(refresh: true);
  }

  /// 加载更多
  Future<void> loadMore() async {
    if (!hasMore.value || isLoading.value) return;
    await loadItems();
  }

{{/if}}
{{#if has_get_api}}
  /// 加载详情
  Future<void> loadDetail(int id) async {
    try {
