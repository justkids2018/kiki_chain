        items.removeWhere((item) => item.id == id);
{{/if}}

{{#if has_get_api}}
        // 清空当前详情
        if (current{{entity_name}}.value?.id == id) {
          current{{entity_name}}.value = null;
        }
{{/if}}

        AppLogger.info('✅ {{entity_name}} deleted successfully');

        Get.snackbar(
          '删除成功',
          '{{entity_name}} 已删除',
          snackPosition: SnackPosition.BOTTOM,
        );
      }

      return success;
    } catch (e, stackTrace) {
