# Unified deploy profile: Tencent production
DEPLOY_PROVIDER="tencent"

# SSH (优先使用环境变量，用于 GitHub Actions Secrets)
DEPLOY_SSH_USER="${DEPLOY_SSH_USER:-ubuntu}"
DEPLOY_SERVER_IP="${DEPLOY_SERVER_IP:-82.156.34.186}"
DEPLOY_REMOTE_DIR="${DEPLOY_REMOTE_DIR:-~/kiki_chain}"

# Domain mapping
DEPLOY_PRIMARY_DOMAIN="kiki.keepthinking.me"
DEPLOY_MOBILE_DOMAIN="kiki.keepthinking.me"
DEPLOY_ADMIN_DOMAIN="admin.keepthinking.me"
DEPLOY_API_DOMAIN="kiki.keepthinking.me"
DEPLOY_API_PATH_PREFIX="/api"
DEPLOY_TLS_CERT_DOMAIN="keepthinking.me"

# Stack identity (used by docker compose -p)
DEPLOY_STACK_NAME="kiki_chain"

# Coexist mode: bind only localhost ports, do not grab 80/443
DEPLOY_ADMIN_HOST_PORT="18080"
DEPLOY_BACKEND_HOST_PORT="18001"
DEPLOY_POSTGRES_HOST_BIND="0.0.0.0"
DEPLOY_POSTGRES_HOST_PORT="15432"

# Backend runtime
DEPLOY_DATABASE_NAME="hikiki_db"
DEPLOY_DATABASE_USER="postgres"
DEPLOY_DATABASE_PASSWORD="postgres"
DEPLOY_JWT_SECRET="hikiki-prod-jwt-secret-2024"
DEPLOY_LOG_LEVEL="info"
DEPLOY_QINIU_ACCESS_KEY="${DEPLOY_QINIU_ACCESS_KEY:-}"
DEPLOY_QINIU_SECRET_KEY="${DEPLOY_QINIU_SECRET_KEY:-}"
DEPLOY_QINIU_BUCKET="${DEPLOY_QINIU_BUCKET:-}"
DEPLOY_QINIU_DOMAIN="${DEPLOY_QINIU_DOMAIN:-}"
DEPLOY_QINIU_UPLOAD_REGION="${DEPLOY_QINIU_UPLOAD_REGION:-z2}"

# Admin runtime
DEPLOY_ADMIN_API_BASE_URL="https://kiki.keepthinking.me"

# Image release (GHCR)
DEPLOY_IMAGE_TAG="${DEPLOY_IMAGE_TAG:-latest}"
DEPLOY_BACKEND_IMAGE="ghcr.io/justkids2018/kiki-chain-backend:${DEPLOY_IMAGE_TAG}"
DEPLOY_ADMIN_IMAGE="ghcr.io/justkids2018/kiki-chain-admin:${DEPLOY_IMAGE_TAG}"
