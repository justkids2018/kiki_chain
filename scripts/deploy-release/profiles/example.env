# Copy this file to profiles/<name>.env and fill values.
DEPLOY_PROVIDER="custom"
DEPLOY_SSH_USER="ubuntu"
DEPLOY_SERVER_IP="0.0.0.0"
DEPLOY_REMOTE_DIR="~/kiki_chain"

DEPLOY_PRIMARY_DOMAIN="kiki.example.com"
DEPLOY_MOBILE_DOMAIN="kiki.example.com"
DEPLOY_ADMIN_DOMAIN="admin.example.com"
DEPLOY_API_DOMAIN="kiki.example.com"
DEPLOY_API_PATH_PREFIX="/api"

DEPLOY_STACK_NAME="kiki_stack"
DEPLOY_ADMIN_HOST_PORT="18080"
DEPLOY_BACKEND_HOST_PORT="18001"
DEPLOY_POSTGRES_HOST_PORT="15432"

DEPLOY_DATABASE_NAME="hikiki_db"
DEPLOY_DATABASE_USER="postgres"
DEPLOY_DATABASE_PASSWORD="postgres"
DEPLOY_JWT_SECRET="change-me"
DEPLOY_LOG_LEVEL="info"

DEPLOY_ADMIN_API_BASE_URL="https://kiki.example.com/api"
