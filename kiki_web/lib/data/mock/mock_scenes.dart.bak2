  /// 所有场景列表
  static final List<Scene> allScenes = [
    ...dailyLifeScenes,
    ...playgroundScenes,
    ...numbersScenes,
    ...lettersScenes,
    ...traditionalFestivalsScenes,
  ];

  /// 按分类ID获取场景列表
  static List<Scene> getScenesByCategory(String categoryId) {
    return allScenes.where((scene) => scene.categoryId == categoryId).toList();
  }

  /// 根据ID获取场景
  static Scene? getSceneById(String id) {
    try {
      return allScenes.firstWhere((scene) => scene.id == id);
    } catch (e) {
      return null;
    }
  }

  /// 获取场景列表（模拟 API 响应）
  static Map<String, dynamic> getScenesByCategoryResponse(String categoryId) {
    final scenes = getScenesByCategory(categoryId);

    return {
      "code": 200,
      "message": "成功",
      "data": {
        "categoryId": categoryId,
        "total": scenes.length,
        "scenes": scenes.map((scene) => scene.toJson()).toList(),
      }
    };
  }

  /// 获取场景详情（模拟 API 响应）
  static Map<String, dynamic>? getSceneDetailResponse(String sceneId) {
    final scene = getSceneById(sceneId);

    if (scene == null) {
      return {
        "code": 404,
        "message": "场景不存在",
        "data": null
      };
    }

    // 获取场景物品
    final items = MockSceneItems.getItemsBySceneId(sceneId);

    return {
      "code": 200,
      "message": "成功",
      "data": {
        "scene": scene.toJson(),
        "items": items.map((item) => item.toJson()).toList(),
      }
    };
  }

  /// 获取所有场景数量
  static int getTotalSceneCount() {
    return allScenes.length;
  }
}
