# kiki - 环境变量配置
# 只包含必需的敏感信息，其他配置在 config/{environment}.toml 中

# ==========================================
# 核心配置（必需）
# ==========================================
ENVIRONMENT=development
# ENVIRONMENT=production

# ==========================================
# 数据库配置（敏感信息）
# ==========================================
# 本地 Docker 数据库
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hikiki_db

# ==========================================
# 安全配置（敏感信息）
# ==========================================
# 重要：生产环境必须修改此密钥为64位以上随机字符串！
JWT_SECRET=d9F8jK2LmQwPzX7VcTaRgHs1NfYb0UJ3DeLoZiCvBkWpEqRsTxYuNmGhIjOlPqRw

# ==========================================
# 七牛云配置（可选）
# ==========================================
# 如果不配置，上传功能将不可用
QINIU_ACCESS_KEY=paTQLNFp0Iq-FV9wEdRUtOxDXKT3cLhrupZdpY_2
QINIU_SECRET_KEY=CQ4JRLP05q7RxgCxPPG_Nj93JniOuXkQC6Vm3_-j
QINIU_BUCKET=19kiki
QINIU_DOMAIN=img.keepthinking.me
# 上传区域（可选，不配置则自动查询）
# z0=华东, z1=华北, z2=华南, na0=北美, as0=东南亚
QINIU_UPLOAD_REGION=z2

# ==========================================
# 七牛云配置（App 上传专用，新增）
# ==========================================
# 说明：此组用于 App 下载链路，后端优先读取 KIKI_KEEP_*。
# 不会影响上面的旧参数，旧参数仍可用于历史上传逻辑。
QINIU_UPLOAD_URL=https://up-z2.qiniup.com
QINIU_DOWNAPP_PREFIX=download/hikiki
